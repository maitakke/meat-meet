rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function canReadVideo(video) {
      return video.isPrivate == false
        || request.auth.uid in video.allowedFamilyIds
        || request.auth.uid == video.familyId;
    }

    // 1. families / families/{familyId}/users
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == familyId;

      match /users/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid == familyId;
      }
    }

    // 2. videos / videos/{videoId}/comments
    match /videos/{videoId} {
      allow read: if isSignedIn() && canReadVideo(resource.data);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.familyId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.familyId;

      match /comments/{commentId} {
        allow read: if isSignedIn()
          && canReadVideo(get(/databases/$(database)/documents/videos/$(videoId)).data);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.familyId;
        allow update: if isSignedIn() && request.auth.uid == resource.data.familyId;
        // 削除は「コメントの投稿者本人」または「動画の所有家族(退会時の一括削除・モデレーション用)」に許可する。
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.familyId
          || request.auth.uid == get(/databases/$(database)/documents/videos/$(videoId)).data.familyId
        );
      }
    }

    // 3. channels
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.familyId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.familyId;
    }

    // 4. channel_subscriptions ("${channelId}_${userId}")
    match /channel_subscriptions/{subscriptionId} {
      // 未フォロー時は該当ドキュメントが存在しない。存在しない get を
      // permission-denied にせず exists()==false で返せるよう null を許可する。
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid == resource.data.familyId);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.familyId
        && subscriptionId == request.resource.data.channelId + '_' + request.resource.data.userId;
      // 削除は「登録した本人」または「チャンネルの所有家族(退会・チャンネル削除時の一括削除用)」に許可する。
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.familyId
        || request.auth.uid == get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.familyId
      );
    }

    // 5. likes ("${videoId}_${userId}")
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.familyId
        && likeId == request.resource.data.videoId + '_' + request.resource.data.userId;
      // 削除は「いいねした本人」または「動画の所有家族(退会時の一括削除用)」に許可する。
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.familyId
        || request.auth.uid == get(/databases/$(database)/documents/videos/$(resource.data.videoId)).data.familyId
      );
    }
  }
}
